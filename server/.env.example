# Connexion à la base PostgreSQL/PostGIS (cf. ../.env pour les identifiants
# du conteneur docker-compose)
DATABASE_URL=postgres://maboule:maboule@localhost:5432/maboule

# Port d'écoute du serveur Express
PORT=3000

# Origines autorisées en CORS, séparées par des virgules (ex: https://maboule.vercel.app).
# Laisser vide en dev local : le serveur reste ouvert à toutes origines
# (endpoint public en lecture seule, sans authentification ni donnée sensible)
CORS_ORIGIN=http://localhost:5173

# Clé API OpenRouteService (openrouteservice.org), utilisée pour le calcul
# d'itinéraires
ORS_API_KEY=
