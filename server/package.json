{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "dotenv -e .env -- tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "migrate:prod": "node dist/db/migrate.js",
    "start:prod": "npm run migrate:prod && npm run start",
    "ingest": "dotenv -e .env -- tsx src/ingestion/run.ts",
    "ingest:prod": "node dist/ingestion/run.js",
    "ingest:cafes": "dotenv -e .env -- tsx src/ingestion/runCafes.ts",
    "ingest:cafes:prod": "node dist/ingestion/runCafes.js",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "dotenv -e .env -- vitest run integration.test.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
