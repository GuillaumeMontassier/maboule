{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "migrate:create": "node-pg-migrate create -j sql --",
    "migrate:up": "dotenv -e .env -- node-pg-migrate up -j sql",
    "migrate:down": "dotenv -e .env -- node-pg-migrate down -j sql",
    "ingest": "dotenv -e .env -- tsx src/ingestion/run.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
