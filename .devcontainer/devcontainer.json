{
    "name": "maboule",
    "dockerComposeFile": [
        "../docker-compose.yml",
        "docker-compose.yml"
    ],
    "service": "app",
    "workspaceFolder": "/workspaces/maboule",
    "shutdownAction": "stopCompose",
    "remoteUser": "node",
    "postCreateCommand": "npm install",
    "forwardPorts": [3000, 5173],
    "portsAttributes": {
        "3000": {
            "label": "server (Express)"
        },
        "5173": {
            "label": "client (Vite)"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss"
            ]
        }
    }
}
